project_name: terrain_segmentation
seed: 42

paths:
  train_images: data/train/images
  train_masks: data/train/masks
  val_images: data/val/images
  val_masks: data/val/masks
  test_images: data/test/images
  test_masks: data/test/masks
  output_dir: outputs
  log_dir: outputs/logs
  checkpoint_dir: outputs/checkpoints

model:
  backbone: nvidia/segformer-b2-finetuned-ade-512-512  # or nvidia/segformer-b3-finetuned-ade-512-512
  use_pretrained: true
  num_classes: 4
  ignore_index: 255

train:
  epochs: 60
  batch_size: 8
  num_workers: 4
  learning_rate: 0.0001
  weight_decay: 0.01
  scheduler: cosine  # cosine | onecycle
  amp: true
  grad_clip: 1.0
  early_stopping_patience: 10
  image_size: 512
  save_best_only: true

loss:
  ce_weight: 0.5
  dice_weight: 0.3
  focal_weight: 0.2
  class_weights: [1.0, 2.0, 3.0, 4.0]  # optional, remove or set null to disable

augmentation:
  enable: true
  random_brightness_contrast: true
  gaussian_noise: true
  motion_blur: true
  color_jitter: true
  perspective_transform: true
  random_scale: true
  horizontal_flip: true
  random_crop: true
  random_shadow: true

inference:
  tta: true
  tta_scales: [384, 512, 640]
  tta_flip: true
  postprocess: true
  closing_kernel: 5
  min_region_size: 100
  background_class: 0

traversability:
  class_costs:
    0: 1
    1: 3
    2: 6
    3: 10
  heatmap_alpha: 0.5

labels:
  0: clear_path
  1: sand
  2: rock
  3: obstacle

visualization:
  overlay_alpha: 0.5
  palette:
    - [0, 255, 0]
    - [255, 255, 0]
    - [255, 128, 0]
    - [255, 0, 0]
